# Container image tags. Migration validation confirms these tags match the running production images.
CLI_PROXY_IMAGE=ghcr.io/xz-dev/cli-proxy-api:candidate-model-channels-07cb171df083
ZCODE_PROXY_IMAGE=ghcr.io/xz-dev/zcode-proxy:candidate-1d26630483fe
SUB2API_IMAGE=ghcr.io/wei-shaw/sub2api:0.1.181
APISIX_IMAGE=docker.io/apache/apisix:3.18.0-debian
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.2

TZ=UTC

# Host exposure. Keep loopback defaults; use a specific Tailscale IP when needed.
CPA_BIND_ADDRESS=127.0.0.1
CPA_PORT=8317
SUB2API_BIND_ADDRESS=127.0.0.1
SUB2API_PORT=8086
APISIX_BIND_ADDRESS=127.0.0.1
APISIX_PORT=9080

# init.sh replaces generated values without printing them. Paste external credentials manually.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CPA_API_KEY=replace-with-generated-cpa-api-key
CPA_MANAGEMENT_KEY=replace-with-generated-cpa-management-key
ZCODE_PROXY_CREDENTIAL_SECRET=replace-with-generated-zcode-credential-secret
ZCODE_PROXY_API_KEY=replace-with-generated-zcode-api-key
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=replace-with-generated-postgres-password
REDIS_PASSWORD=replace-with-generated-redis-password
JWT_SECRET=replace-with-generated-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-generated-totp-key
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-generated-admin-password

SUB2API_RUN_MODE=standard
SUB2API_TRUSTED_PROXIES=172.22.0.3/32
SUB2API_URL_ALLOWLIST_ENABLED=true
SUB2API_UPSTREAM_HOSTS=cli-proxy-api
GATEWAY_MODELS_LIST_READ_MAX_BYTES=16777216
LOG_ROTATION_MAX_SIZE_MB=20
LOG_ROTATION_MAX_BACKUPS=5
LOG_ROTATION_MAX_AGE_DAYS=7
