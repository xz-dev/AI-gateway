# Container images. External images use non-floating version tags or full content digests.
# Keeper and WS bridge use the published compatibility-lock digests; keepalive retains its existing pin.
EGRESS_PROXY_IMAGE=ai-gateway-squid:6.13-2-deb13u3-r1
NETNS_GUARD_IMAGE=docker.io/library/alpine:3.24.2
SOCAT_IMAGE=docker.io/alpine/socat:1.8.1.3
AI_SSE_KEEPALIVE_PROXY_IMAGE=ghcr.io/xz-dev/ai-sse-keepalive-proxy:1c489390927a986b7aacd3ebdfef3ea33f51d15d@sha256:bc5e360f98a9c71766bef26fbd67d88e93a2e93b372fcd9e5245788475d336f3
OPENAI_API_CACHE_KEEPER_IMAGE=ghcr.io/xz-dev/openai-api-cache-keeper@sha256:ef4dc093e218bed00b5deabff6951e7781f6ce5a57f0c34ee021844ed2d6798b
RESPONSES_WS_SSE_BRIDGE_IMAGE=ghcr.io/xz-dev/responses-ws-sse-bridge@sha256:dede337bbe10fc3c79f0c7a7e23d0bbf6f4adf28ba22610fbe0fdefa75ccd411
# Optional provider-sidecar overrides use this version-pinned tunnel image.
# Keep each concrete sidecar image and its runtime-specific settings only in the ignored .env/override.
TUN2PROXY_IMAGE=ghcr.io/tun2proxy/tun2proxy:v0.8.4@sha256:0469219b2f65aa2c80687a783fd788e294e6053c636a71755d5e0c8282860968
# Capacity fork images below follow ci/large-request/ci/compatibility-lock.json.
# Pins alone do not enable production capacity: see docs/records/maintenance-capacity-closeout-2026-11-09.md.
CLI_PROXY_IMAGE=ghcr.io/xz-dev/cliproxyapi@sha256:4835aa6c189f2db5d4a2558e4533e9b7eb185ece17b20b4f3b10ea2134bf2b6a
SUB2API_IMAGE=ghcr.io/xz-dev/sub2api@sha256:56557012dc75e96feb22e26fdb36fce057ab1e660cba8f907bf4b3d85472472a
APISIX_IMAGE=docker.io/apache/apisix:3.19.0-debian
POSTGRES_IMAGE=docker.io/library/postgres:18.6-alpine3.24
REDIS_IMAGE=docker.io/library/redis:8.10.2-alpine3.23
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
# AISIX capacity fork; the historical PR1387 publisher is superseded.
AISIX_IMAGE=ghcr.io/xz-dev/aisix@sha256:b9d01af4a8d9baa736767b3995ed76fb0c0450816daa40f84bf4b1c39271e9c6
# Independently versioned server-rendered page; does not patch AISIX source.
AISIX_STATUS_IMAGE=ghcr.io/xz-dev/ai-gateway-aisix-status:0.2.3@sha256:4ea017ad0e84de8810f75ae637e4198ac56f692fe0447ae7924223010269de4f
# model-catalog: Codex/OpenAI model catalog and /models-table diagnostics.
MODEL_CATALOG_IMAGE=ghcr.io/xz-dev/ai-gateway-model-catalog:v1.4.0-6f595ab@sha256:f98cb5013c337420dd6f98112c053a6ad686185c723cf092062a5b0f541620ad

TZ=UTC

# Host exposure. Keep loopback defaults; use a specific Tailscale IP when needed.
CPA_BIND_ADDRESS=127.0.0.1
CPA_PORT=8317
SUB2API_BIND_ADDRESS=127.0.0.1
SUB2API_PORT=8086
APISIX_BIND_ADDRESS=127.0.0.1
APISIX_PORT=9080
# Operator uses the same keepalive/keeper/API auth chain without public filters.
# Bind only loopback or a concrete Tailscale IPv4; node ACLs are deployment inputs.
OPERATOR_BIND_ADDRESS=127.0.0.1
OPERATOR_PORT=8087
AISIX_STATUS_BIND_ADDRESS=127.0.0.1
AISIX_STATUS_PORT=3001
# Host Tailscale IPv4. The models table (:9083) binds 127.0.0.1 and this address.
TAILSCALE_IP=100.64.0.1

# init.sh replaces generated values without printing them. Paste external credentials manually.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CPA_API_KEY=replace-with-generated-cpa-api-key
CPA_MANAGEMENT_KEY=replace-with-generated-cpa-management-key
# AISIX caller key dedicated to the optional catalog source.
AISIX_CATALOG_KEY=replace-with-generated-aisix-catalog-key
# Optional: separate CPA client key for model-catalog (defaults to CPA_API_KEY)
#CPA_CLIENT_KEY=
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=replace-with-generated-postgres-password
REDIS_PASSWORD=replace-with-generated-redis-password
JWT_SECRET=replace-with-generated-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-generated-totp-key
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-generated-admin-password

SUB2API_RUN_MODE=standard
SUB2API_TRUSTED_PROXIES=172.30.26.3/32
# AI SSE protocol keepalives for OpenAI Responses/Chat and Anthropic Messages.
AI_SSE_KEEPALIVE_PROXY_HEADER_WAIT=2s
AI_SSE_KEEPALIVE_PROXY_IDLE_INTERVAL=15s
AI_SSE_KEEPALIVE_PROXY_MAX_INSPECT_BODY_BYTES=8388608
#AI_SSE_KEEPALIVE_PROXY_GOMEMLIMIT=96MiB
# Shared cache before Sub2API. Entries count response-ID aliases; bytes=0 removes only the live payload cap.
OPENAI_API_CACHE_KEEPER_GOMEMLIMIT=256MiB
OPENAI_API_CACHE_KEEPER_STORE_TTL=10m
OPENAI_API_CACHE_KEEPER_STORE_MAX_ENTRIES=100
OPENAI_API_CACHE_KEEPER_STORE_MAX_BYTES=0
GATEWAY_MODELS_LIST_READ_MAX_BYTES=67108864
# Keep false unless a reviewed Sub2API account explicitly enables ctx_pool/passthrough/http_bridge.
GATEWAY_OPENAI_WS_MODE_ROUTER_V2_ENABLED=false
LOG_ROTATION_MAX_SIZE_MB=20
LOG_ROTATION_MAX_BACKUPS=5
LOG_ROTATION_MAX_AGE_DAYS=7

# ai-sse-keepalive-proxy downstream WebSocket keepalive knobs (opt-in).
# WS_PING_INTERVAL=0s disables; prod sets 15s. Timeout must stay below interval.
#AI_SSE_KEEPALIVE_PROXY_WS_PING_INTERVAL=15s
#AI_SSE_KEEPALIVE_PROXY_WS_PING_TIMEOUT=5s
#AI_SSE_KEEPALIVE_PROXY_WS_WRITE_TIMEOUT=120s
#AI_SSE_KEEPALIVE_PROXY_WS_HANDSHAKE_TIMEOUT=10s
