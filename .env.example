# Container images. Egress proxy builds locally from the pinned Debian base and package version.
EGRESS_PROXY_IMAGE=ai-gateway-squid:6.13-2-deb13u2
NETNS_GUARD_IMAGE=docker.io/library/alpine@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
# Optional production overrides use these official digest-pinned images.
TUN2PROXY_IMAGE=ghcr.io/tun2proxy/tun2proxy@sha256:562a4208ecf1f53e3c790af512bcc1ce2656f1d10d3541614173eed8b3185708
ZCODE_PROXY_IMAGE=ghcr.io/tridefender/zcode-proxy@sha256:947dcf83314e16a87b61191c4847bf3d4f10baf4c370c25191d5a49f08a06e52
CLI_PROXY_IMAGE=ghcr.io/xz-dev/cli-proxy-api@sha256:1da1d6ab90c2d7a569e8ebcb6eeb25549e2a535b03fbac54f11ceca189c49ae8
SUB2API_IMAGE=ghcr.io/wei-shaw/sub2api@sha256:b0b9dec5ab978e8b872cedc2706e695c944b5322ae56b20ba99ee9d3871fe810
APISIX_IMAGE=docker.io/apache/apisix@sha256:51bb7b7fcd4162bec53f276c5a9b7b93d5de55723586842becb3e5f165fc0281
POSTGRES_IMAGE=docker.io/library/postgres@sha256:63bdc97d67b5133bf0e5ebd500bec6d046fa851dc81340d838f0347e616107e8
REDIS_IMAGE=docker.io/library/redis@sha256:9c3ecc609a8087c0f11c494fefaf37a8f7bf9a967631d4a0da8967a9810be354
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38

TZ=UTC

# Host exposure. Keep loopback defaults; use a specific Tailscale IP when needed.
CPA_BIND_ADDRESS=127.0.0.1
CPA_PORT=8317
SUB2API_BIND_ADDRESS=127.0.0.1
SUB2API_PORT=8086
APISIX_BIND_ADDRESS=127.0.0.1
APISIX_PORT=9080

# init.sh replaces generated values without printing them. Paste external credentials manually.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CPA_API_KEY=replace-with-generated-cpa-api-key
CPA_MANAGEMENT_KEY=replace-with-generated-cpa-management-key
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=replace-with-generated-postgres-password
REDIS_PASSWORD=replace-with-generated-redis-password
JWT_SECRET=replace-with-generated-jwt-secret
TOTP_ENCRYPTION_KEY=replace-with-generated-totp-key
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-generated-admin-password

SUB2API_RUN_MODE=standard
SUB2API_TRUSTED_PROXIES=172.22.0.3/32
GATEWAY_MODELS_LIST_READ_MAX_BYTES=16777216
LOG_ROTATION_MAX_SIZE_MB=20
LOG_ROTATION_MAX_BACKUPS=5
LOG_ROTATION_MAX_AGE_DAYS=7
